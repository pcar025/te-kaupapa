{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerifyCallerIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "ValidateTeKaupapaCognitoTemplate",
      "Effect": "Allow",
      "Action": "cloudformation:ValidateTemplate",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "CreateOnlyTeKaupapaStagingCognitoStack",
      "Effect": "Allow",
      "Action": "cloudformation:CreateStack",
      "Resource": "arn:aws:cloudformation:ap-southeast-2:905418481310:stack/te-kaupapa-staging-*/*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::Cognito::UserPool",
            "AWS::Cognito::UserPoolClient",
            "AWS::Cognito::UserPoolDomain"
          ]
        },
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "UpdateOnlyTaggedTeKaupapaStagingCognitoStacks",
      "Effect": "Allow",
      "Action": "cloudformation:UpdateStack",
      "Resource": "arn:aws:cloudformation:ap-southeast-2:905418481310:stack/te-kaupapa-staging-*/*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::Cognito::UserPool",
            "AWS::Cognito::UserPoolClient",
            "AWS::Cognito::UserPoolDomain"
          ]
        },
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "te-kaupapa",
          "aws:ResourceTag/Environment": "staging",
          "aws:ResourceTag/ManagedBy": "te-kaupapa-repository",
          "aws:ResourceTag/Purpose": "authentication-pilot"
        }
      }
    },
    {
      "Sid": "InspectOnlyTaggedTeKaupapaStagingStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStacks",
        "cloudformation:GetTemplate"
      ],
      "Resource": "arn:aws:cloudformation:ap-southeast-2:905418481310:stack/te-kaupapa-staging-*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "te-kaupapa",
          "aws:ResourceTag/Environment": "staging",
          "aws:ResourceTag/ManagedBy": "te-kaupapa-repository",
          "aws:ResourceTag/Purpose": "authentication-pilot"
        }
      }
    },
    {
      "Sid": "DeleteOnlyTheTwoInspectedFailedTeKaupapaStacks",
      "Effect": "Allow",
      "Action": "cloudformation:DeleteStack",
      "Resource": [
        "arn:aws:cloudformation:ap-southeast-2:905418481310:stack/te-kaupapa-staging-authentication/*",
        "arn:aws:cloudformation:ap-southeast-2:905418481310:stack/te-kaupapa-staging-authentication-v2/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "te-kaupapa",
          "aws:ResourceTag/Environment": "staging",
          "aws:ResourceTag/ManagedBy": "te-kaupapa-repository",
          "aws:ResourceTag/Purpose": "authentication-pilot"
        }
      }
    },
    {
      "Sid": "VerifyOnlyTheTwoFailedStackRecordsAreGone",
      "Effect": "Allow",
      "Action": "cloudformation:DescribeStacks",
      "Resource": [
        "arn:aws:cloudformation:ap-southeast-2:905418481310:stack/te-kaupapa-staging-authentication/*",
        "arn:aws:cloudformation:ap-southeast-2:905418481310:stack/te-kaupapa-staging-authentication-v2/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "CreateOnlyRequiredTaggedTeKaupapaUserPool",
      "Effect": "Allow",
      "Action": "cognito-idp:CreateUserPool",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "te-kaupapa",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/ManagedBy": "te-kaupapa-repository",
          "aws:RequestTag/Purpose": "authentication-pilot"
        }
      }
    },
    {
      "Sid": "ManageOnlyTaggedTeKaupapaUserPools",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:CreateUserPoolDomain",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:DeleteUserPoolDomain",
        "cognito-idp:DescribeUserPool",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:DescribeUserPoolDomain",
        "cognito-idp:ListTagsForResource",
        "cognito-idp:ListUserPoolClients",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:UpdateUserPoolClient",
        "cognito-idp:UpdateUserPoolDomain"
      ],
      "Resource": "arn:aws:cognito-idp:ap-southeast-2:905418481310:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "te-kaupapa",
          "aws:ResourceTag/Environment": "staging",
          "aws:ResourceTag/ManagedBy": "te-kaupapa-repository",
          "aws:ResourceTag/Purpose": "authentication-pilot"
        }
      }
    },
    {
      "Sid": "TagOnlyNewRequiredTeKaupapaUserPools",
      "Effect": "Allow",
      "Action": "cognito-idp:TagResource",
      "Resource": "arn:aws:cognito-idp:ap-southeast-2:905418481310:userpool/*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Application",
            "Environment",
            "ManagedBy",
            "Purpose"
          ]
        },
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "te-kaupapa",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/ManagedBy": "te-kaupapa-repository",
          "aws:RequestTag/Purpose": "authentication-pilot"
        }
      }
    },
    {
      "Sid": "CheckTeKaupapaCognitoDomainAvailability",
      "Effect": "Allow",
      "Action": "cognito-idp:DescribeUserPoolDomain",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadOnlyCognitoPoolDiscovery",
      "Effect": "Allow",
      "Action": "cognito-idp:ListUserPools",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "AdministerPilotUsersOnlyInTaggedTeKaupapaPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminDeleteUser",
        "cognito-idp:AdminGetUser"
      ],
      "Resource": "arn:aws:cognito-idp:ap-southeast-2:905418481310:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "te-kaupapa",
          "aws:ResourceTag/Environment": "staging",
          "aws:ResourceTag/ManagedBy": "te-kaupapa-repository",
          "aws:ResourceTag/Purpose": "authentication-pilot"
        }
      }
    },
    {
      "Sid": "ReadOnlySesAccountAndIdentityDiscovery",
      "Effect": "Allow",
      "Action": [
        "ses:GetAccount",
        "ses:ListEmailIdentities"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "InspectSesIdentityVerificationOnly",
      "Effect": "Allow",
      "Action": "ses:GetEmailIdentity",
      "Resource": "arn:aws:ses:ap-southeast-2:905418481310:identity/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    }
  ]
}
