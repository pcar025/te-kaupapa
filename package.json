{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "check:local-live-runtime": "tsx server/scripts/check-local-live-runtime.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom --maxWorkers=1",
    "test:server": "vitest run --environment node server --exclude='server/**/*.integration.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "provision:cognito-user": "tsx server/scripts/provision-cognito-user.ts",
    "provision:safety-assessment": "tsx server/scripts/provision-safety-assessment.ts",
    "provision:pou-specification": "tsx server/scripts/provision-pou-specification.ts",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1106.0",
    "@elevenlabs/react": "^1.12.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@types/pdfkit": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "jose": "^6.2.8",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
