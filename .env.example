# The browser uses same-origin /api calls only. Do not prefix these with VITE_.
NODE_ENV=development
PORT=3011
DATABASE_URL=postgresql://te_kaupapa:change-me@localhost:5432/te_kaupapa
APP_ORIGIN=http://localhost:3011
FRONTEND_ORIGIN=http://localhost:8443
SESSION_COOKIE_NAME=te_kaupapa_session
# Generate a distinct 32+ character secret for each environment; never commit it.
SESSION_COOKIE_SECRET=replace-with-a-long-random-server-secret
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60

# Set all three values after the dedicated Te Kaupapa Cognito staging stack is active.
COGNITO_CLIENT_ID=
# Optional for a public client. If a confidential app client is selected, keep this server-only.
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_example
COGNITO_MANAGED_LOGIN_DOMAIN=https://example.auth.ap-southeast-2.amazoncognito.com

# Server-only ElevenLabs configuration. Never prefix these with VITE_, commit a
# real key, or expose the key/token through browser configuration.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_0301kzpzekqbe8yaagpm4hy0sq1v
ELEVENLABS_AGENT_BRANCH_ID=agtbrch_7701kzpzemctezt9bgxt2z40wtsz
ELEVENLABS_AGENT_ENVIRONMENT=staging

# Only add narrowly approved browser origins. The Vite proxy needs none for normal local development.
CORS_ALLOWED_ORIGINS=
